# Server Port
PORT=5000

# MongoDB Atlas Connection URI (Cluster: Cluster0, Database: knowbridge, Collection: memories)
# Replace <username> and <password> with your actual database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/knowbridge?retryWrites=true&w=majority

# Google Gemini API Key (Get a free key in 30 seconds at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
